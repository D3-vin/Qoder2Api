# Qoder2API Configuration File
# Copy this file to .env and fill in your values 

# Qoder Personal Access Token (required)
# Get your PAT from https://qoder.com/ account settings
QODER_PAT=your_qoder_pat_token_here

# Multiple PATs (optional): comma/newline separated. Takes precedence over QODER_PAT.
# Pool fails over to the next PAT on agent-limit errors (code 115).
# Dashboard (/) can add/remove/select PATs at runtime; changes persist to config.json.
# QODER_PAT_LIST=pt-aaa…,pt-bbb…,pt-ccc…

# Server host (optional, default: 127.0.0.1)
QODER_HOST=0.0.0.0

# Server port (optional, default: 8963)
QODER_PORT=8963

# Model selection (optional, default: lite)
# Available models: see GET /v1/models (live from Qoder)
QODER_MODEL=lite

# Prompt template size: min (default, ~2 KB) | full (CLI dump, lazy-loaded)
# Both profiles read baseprompt_min.json; full additionally requires baseprompt.json next to the binary.
# QODER_PROMPT_PROFILE=min
# QODER_PROMPT_PROFILE=full

# Outbound proxy
# QODER_PROXY_ENABLED=true
# QODER_PROXY_URL=http://127.0.0.1:8888
# QODER_INSECURE_SKIP_VERIFY=true

# Machine credentials for CLI step 11 — UMID SDK
# Obtain these values from your authenticated Qoder IDE session
# QODER_MACHINE_ID=your_machine_id_here
# QODER_MACHINE_TOKEN=P1gA_your_machine_token_here
# QODER_MACHINE_TYPE=your_machine_type_here
# Note: machine tokens typically start with the `P1gA` prefix
