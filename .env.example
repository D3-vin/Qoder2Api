# Qoder2API Configuration File
# Copy this file to .env and fill in your values 

# Qoder Personal Access Token (required)
# Get your PAT from https://qoder.com/ account settings
QODER_PAT=your_qoder_pat_token_here

# Multiple PATs (optional): comma/newline separated. Takes precedence over QODER_PAT.
# Pool fails over to the next PAT on agent-limit errors (code 115).
# Dashboard (/) can add/remove/select PATs at runtime; changes persist to config.json.
# QODER_PAT_LIST=pt-aaa…,pt-bbb…,pt-ccc…

# Server host (optional, default: 127.0.0.1)
QODER_HOST=0.0.0.0

# Server port (optional, default: 8963)
QODER_PORT=8963

# Log level (optional, default: info). Values: debug | info | warn | error.
# debug shows [BEARER DEBUG]/[DEBUG]/per-line stream output; info shows operational lines.
# QODER_LOG_LEVEL=info

# Model selection (optional, default: lite)
# Available models: see GET /v1/models (live from Qoder)
QODER_MODEL=lite

# Prompt template size: min (default, ~2 KB) | full (CLI dump, lazy-loaded)
# Templates are embedded in the binary and auto-extracted on first run; a file on
# disk (if present) takes precedence over the embedded copy.
# QODER_PROMPT_PROFILE=min
# QODER_PROMPT_PROFILE=full

# Claude Desktop gateway mode:
# - /v1/models returns Claude-like IDs only
# - map (Desktop thinking UI needs 4.6+ opus/sonnet IDs):
#   opus-4-7→qwen3.8-max, opus-4-8→qwen3.7-max, sonnet-4-6→kimi-k3, opus-4-6→glm-5.2
#   extra: 3-5-haiku-latest→lite
# - supports1m: true → Desktop shows "1M context window" variant ([1m] suffix in requests)
# QODER_CLAUDE_DESKTOP_PREFER_1M=true  # default: 1M variant selected first in picker
# Keep OFF for OpenCode / normal OpenAI clients
# QODER_CLAUDE_DESKTOP=true

# Anthropic / Claude Desktop extras
# Default when unknown claude-* id is sent
# QODER_ANTHROPIC_DEFAULT_MODEL=qwen3.7-max
# Force one family tier for all models in normal /v1/models (optional)
# QODER_ANTHROPIC_FAMILY_TIER=sonnet

# HTTPDNS IP for X-Qoder-HTTPDNS-IP header (optional, CLI uses resolved node IP)
# Example: QODER_HTTPDNS_IP=8.211.37.33
QODER_HTTPDNS_IP=

# Outbound proxy for sniffing/debug (optional, used by Go bridge and tools/test_cli_flow.py)
# QODER_PROXY_ENABLED=true
# QODER_PROXY_URL=http://127.0.0.1:8888
# QODER_INSECURE_SKIP_VERIFY=true

# Machine credentials for CLI step 11 — UMID SDK (tools/gen_umid_token.py)
# По умолчанию test_cli_flow генерирует P1gA + base64url(63 байта)
# Свои токены с ПК: см. файл 1 в репо или runtime-info qodercli
# QODER_MACHINE_ID=uuid — стабильная генерация из seed
# QODER_MACHINE_TOKEN=P1gAtXG2nr_N9Pc-...
# QODER_MACHINE_TYPE=b2f25b02910b0ffbcc
